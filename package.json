{
  "name": "@ideasquared/ship",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Deploy tooling for every ideaSquared product: a ship.yaml manifest and a reusable GitHub Actions workflow.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "bin": {
    "ship": "dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ]
}
